rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inkception: submissions are written only by the `analyze` Cloud Function
    // (the Admin SDK bypasses these rules). No browser access at all.
    match /submissions/{id} {
      allow read, write: if false;
    }

    // Anything not matched above is denied by default.
    // Add rules for other apps in this project here.
  }
}
